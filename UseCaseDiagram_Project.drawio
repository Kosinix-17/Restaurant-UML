        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultTextAlignment center\nskinparam ActivityBackgroundColor #FEFECE\nskinparam ActivityBorderColor #A680B8\n\nstart\n\n:Customer requests the bill;[cite: 3, 4]\n:System calculates subtotal and tax;[cite: 3]\n\nif (Customer has a discount / loyalty voucher?) then (yes)\n  :Manager applies discount to bill;\nelse (no)\n  :Keep standard total;\nendif\n\n:Display final bill to customer;[cite: 4]\n:Customer chooses payment method;\n\nif (Payment method is Cash or Card?) then (Card / Cash)\n  :Process transaction;\n  if (Payment approved?) then (yes)\n    :Mark bill as Paid;\n  else (no)\n    :Ask for another payment method;\n  endif\nelse (Split bill)\n  :Split bill into equal/custom parts;\n  :Process each payment part;\nendif\n\nif (Customer leaves a tip?) then (yes)\n  :Record tip amount;[cite: 4]\n  :Add tip to TipPool;[cite: 3, 4]\nelse (no)\n  :Skip tip recording;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hb1-Wb-goXYzwA7vqLBl-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
