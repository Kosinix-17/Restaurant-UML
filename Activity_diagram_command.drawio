        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass Employee {\n  + id: String\n  + name: String\n  + role: String\n  + hoursWorked: float\n}\n\nclass Manager {\n}\n\nclass HeadChef {\n}\n\nclass Commis {\n}\n\nclass Server {\n}\n\nEmployee &lt;|-- Manager\nEmployee &lt;|-- HeadChef\nEmployee &lt;|-- Commis\nEmployee &lt;|-- Server\n\nclass Customer {\n  + id: String\n  + name: String\n}\n\nclass Table {\n  + number: int\n  + seats: int\n  + status: String\n}\n\nclass Order {\n  + id: String\n  + date: Date\n  + status: String\n}\n\nclass OrderLine {\n  + quantity: int\n  + notes: String\n}\n\nCustomer \&quot;1\&quot; --&gt; \&quot;*\&quot; Order : places\nTable \&quot;1\&quot; --&gt; \&quot;*\&quot; Order : accommodates\nServer \&quot;1\&quot; --&gt; \&quot;*\&quot; Order : creates\nOrder \&quot;1\&quot; --&gt; \&quot;*\&quot; OrderLine : contains\nOrderLine \&quot;*\&quot; --&gt; \&quot;1\&quot; Dish : concerns\n\nclass Dish {\n  + name: String\n  + price: float\n  + category: String\n}\n\nclass Recipe {\n  + preparationSteps: String\n}\n\nclass Ingredient {\n  + name: String\n  + unit: String\n  + unitCost: float\n  + minimumThreshold: float\n}\n\nclass StockBatch {\n  + quantity: float\n  + deliveryDate: Date\n  + expiryDate: Date\n}\n\nDish \&quot;1\&quot; --&gt; \&quot;1\&quot; Recipe : uses\nRecipe \&quot;*\&quot; --&gt; \&quot;*\&quot; Ingredient : requires\nIngredient \&quot;1\&quot; --&gt; \&quot;*\&quot; StockBatch : composed of\nSupplier \&quot;1\&quot; --&gt; \&quot;*\&quot; PurchaseOrder : receives\n\nclass Supplier {\n  + name: String\n  + contact: String\n  + products: String\n}\n\nclass PurchaseOrder {\n  + date: Date\n  + status: String\n}\n\nclass Bill {\n  + subtotal: float\n  + tax: float\n  + discount: float\n  + total: float\n}\n\nclass Payment {\n  + amount: float\n  + method: String\n  + date: Date\n}\n\nOrder \&quot;1\&quot; --&gt; \&quot;1\&quot; Bill : generates\nBill \&quot;1\&quot; --&gt; \&quot;*\&quot; Payment : settled by\nOrder \&quot;1\&quot; --&gt; \&quot;*\&quot; Tip : generates\nTip \&quot;1\&quot; --&gt; \&quot;1\&quot; TipDistribution : grouped in\nTipDistribution \&quot;*\&quot; --&gt; \&quot;*\&quot; Employee : distributed among\n\nclass Tip {\n  + amount: float\n  + date: Date\n}\n\nclass TipDistribution {\n  + date: Date\n  + total: float\n  + sharePerEmployee: float\n}\n\nclass WasteRecord {\n  + quantity: float\n  + reason: String\n  + date: Date\n}\n\nclass FinancialReport {\n  + period: String\n  + revenue: float\n  + costs: float\n  + waste: float\n  + margin: float\n}\n\nWasteRecord \&quot;*\&quot; --&gt; \&quot;1\&quot; Ingredient : concerns\nManager \&quot;1\&quot; --&gt; \&quot;1\&quot; FinancialReport : consults\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="GHbrRU54H1wodr_fHpCz-2">
