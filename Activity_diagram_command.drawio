        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultTextAlignment center\nskinparam ActivityBackgroundColor #FEFECE\nskinparam ActivityBorderColor #A680B8\n\nstart\n\n:Staff inspects storage and kitchen;\nif (Spoiled, expired, or damaged items found?) then (yes)\n  :Select ingredient and enter quantity;\n  \n  if (Reason is Expiration date?) then (yes)\n    :Flag FEFO rotation failure;\n  else (no)\n    :Flag accidental damage or cooking waste;\n  endif\n  \n  :Record WasteRecord in system;\n  :Deduct quantity from StockBatch;\n  :Calculate financial loss cost;\n  \n  if (Loss cost exceeds manager alert limit?) then (yes)\n    :Trigger financial alert for Manager review;\n  else (no)\n    :Log normally in monthly report;\n  endif\nelse (no)\n  :No waste recorded;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hnsOtV1wFh_KvOPoSJgN-1">
