        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultTextAlignment center\nskinparam ActivityBackgroundColor #FEFECE\nskinparam ActivityBorderColor #A680B8\n\nstart\n\n:Server opens table;\nif (Table is available / free?) then (yes)\n  :Open table session;\nelse (no)\n  :Display error: Table occupied;\n  stop\nendif\n\nrepeat\n  :Server takes dish selection;\n  if (Dish exists in menu?) then (yes)\n    :Check stock and apply FEFO rule;[cite: 4]\n    if (Sufficient stock available?) then (yes)\n      :Add OrderLine to Order;[cite: 4]\n    else (no)\n      :Notify customer (Out of stock);\n      :Propose alternative dish;\n    endif\n  else (no)\n    :Select valid menu item;\n  endif\n\nrepeat while (Customer wants to add more items?) is (yes)\n\nif (Order is confirmed by server?) then (yes)\n  :Send order to KitchenDisplay;[cite: 4]\n  :Deduct stock automatically;[cite: 4]\nelse (no)\n  :Cancel or modify order;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zp_ntWvfGPFR7wyBp_0R-1">
